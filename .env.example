# ─────────────────────────────────────────────────────────────────────────────
# Scholars Stack — environment variables
#
# How this file is used
#   0. Just want to look around? You need none of this: `pnpm dev:demo` runs the
#      whole site with an in-memory database, test logins and simulated payments.
#   1. Copy it:            cp .env.example .env
#   2. Fill in the values  (SETUP.md says where each one comes from)
#   3. Split it for apps:  pnpm env:sync
#        → apps/web/.env.local   gets only the VITE_* lines (public, shipped to browsers)
#        → apps/api/.dev.vars    gets everything else (server-only secrets for the Worker)
#   4. Production secrets: pnpm secrets:push   (runs `wrangler secret put` for each server key)
#
# Rules
#   - Never commit .env, apps/web/.env.local or apps/api/.dev.vars (already in .gitignore).
#   - Never paste secret values into chat, issues or screenshots.
#   - Anything starting with VITE_ is visible to every visitor. Only public keys go there.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# A. PUBLIC  (browser-safe, baked into the website at build time)
# ═════════════════════════════════════════════════════════════════════════════

VITE_APP_NAME="Scholars Stack"
# The API lives on the same domain under /api, so this rarely changes.
VITE_API_BASE_URL=/api
VITE_ALLOWED_EMAIL_DOMAIN=vitbhopal.ac.in

# Supabase → Project Settings → API Keys → "Publishable key" (sb_publishable_…)
# (older projects call this the "anon" key — either works)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Razorpay → Account & Settings → API Keys → Key Id (starts rzp_test_ in test mode)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Cloudflare → Turnstile → your widget → Site Key
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx


# ═════════════════════════════════════════════════════════════════════════════
# B. SERVER  (Cloudflare Worker only — never shipped to browsers)
# ═════════════════════════════════════════════════════════════════════════════

# development | staging | production
APP_ENV=development
# Public site address, used for links in emails (no trailing slash)
APP_URL=http://localhost:5173
# Optional public origins used by the secrets-push script for deployed Workers.
APP_URL_PRODUCTION=
APP_URL_STAGING=
ALLOWED_EMAIL_DOMAIN=vitbhopal.ac.in
# Comma-separated addresses that get the admin pages. Exact match only: a different spelling,
# a "+tag" or a look-alike is a different person. An admin may use a non-college address
# (e.g. a Gmail), but it must ALSO be in the database list: run `pnpm ops admins:sync`
# after changing this line, so the sign-up check lets exactly these addresses in.
# Admins sign in with Google or an emailed one-time link; password sign-ins are refused.
ADMIN_EMAILS=you@vitbhopal.ac.in,second-admin@vitbhopal.ac.in
# Optional. The newest batch year (1st years). Leave empty to roll over automatically every July.
CURRENT_INTAKE_YEAR=

# ── Supabase ──
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Project Settings → API Keys → "Secret key" (sb_secret_…)
# (older projects: "service_role" key). Full database access — treat like a password.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# Only for older projects still on the legacy shared JWT secret.
# New projects verify tokens through the public JWKS endpoint and leave this empty.
SUPABASE_LEGACY_JWT_SECRET=

# ── Razorpay ──
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Razorpay → Webhooks → the secret you type when creating the webhook
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# ── Secrets this app signs things with (generate each with: openssl rand -base64 32) ──
# Signs the 2-minute viewer token that lets page requests skip the database
VIEWER_TOKEN_SECRET=
# Signs the HttpOnly device cookie (2-device cap)
DEVICE_COOKIE_SECRET=
# Derives the tile order of every scrambled page. Must be the SAME value in the
# Worker and GitHub Actions converter. Changing it later means re-converting all pages.
TILE_SEED_SECRET=
# Shared between the Worker and GitHub Actions converter
CONVERTER_CALLBACK_SECRET=

# ── Notes in R2 ──
# The folder in your bucket the admin "Import" tab reads, e.g. drive-imports/23 Batch/<course>/…
# (The bucket itself is set in apps/api/wrangler.jsonc: "bucket_name": "scholarstack".)
IMPORT_ROOT=drive-imports/

# ── Feature & course announcement emails (Brevo, same account as the sign-in codes) ──
# Brevo → SMTP & API → API keys → Generate (starts xkeysib-). Leave empty to switch emails off.
BREVO_API_KEY=
# A sender you verified in Brevo → Senders & IP (use your domain, not gmail)
EMAIL_FROM=hello@your-domain.in
EMAIL_FROM_NAME="Scholars Stack"
# Announcement emails per day. Brevo's free plan allows about 300/day in total, and sign-in
# codes come out of the same allowance, so keep headroom. Raise it on a paid plan.
EMAIL_DAILY_LIMIT=200

# ── Session and abuse limits (sensible defaults, change any time) ──
MAX_DEVICES=2
VIEWER_TOKEN_TTL_SECONDS=120
PAGES_PER_DAY=600
# Pages per minute is enforced by Cloudflare's rate-limit binding: edit "limit" under
# "ratelimits" in apps/api/wrangler.jsonc (default 40). This value is only used locally.
PAGES_PER_MINUTE=40
# Supabase access-token lifetime (set 600 seconds in Authentication → Sessions) and
# refresh-token reuse detection are dashboard settings, see SETUP.md.


# ═════════════════════════════════════════════════════════════════════════════
# C. CONVERTER  (local CLI credentials; also add required values to GitHub Actions secrets)
# ═════════════════════════════════════════════════════════════════════════════

# Cloudflare → R2 → Manage R2 API Tokens → Create token (Object Read & Write, this bucket only)
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET=scholarstack
# This localhost callback is for local conversion only. In GitHub Actions, set the
# deployed HTTPS callback URL as the CONVERTER_CALLBACK_URL repository secret.
CONVERTER_CALLBACK_URL=http://localhost:8787/api/internal/conversion
# CONVERTER_CALLBACK_SECRET and TILE_SEED_SECRET (same values as section B)


# ═════════════════════════════════════════════════════════════════════════════
# D. CLI ACCESS  (used only when running database setup or Wrangler from this computer)
# ═════════════════════════════════════════════════════════════════════════════

# Cloudflare → My Profile → API Tokens → "Edit Cloudflare Workers" template
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Supabase → Account → Access Tokens. Lets `pnpm ops db:apply` run the migrations over HTTPS
# and switch on the sign-up hook.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
SUPABASE_DB_PASSWORD=


# ═════════════════════════════════════════════════════════════════════════════
# NOT IN THIS FILE — these go straight into the Supabase dashboard (see SETUP.md)
#   Google OAuth client ID + secret   → Authentication → Sign In / Providers → Google
#   Brevo SMTP host/user/key          → Authentication → Emails → SMTP settings
#   Turnstile secret key              → Authentication → Attack Protection → CAPTCHA
# R2 bucket name for the Worker lives in apps/api/wrangler.jsonc as the NOTES binding.
# ═════════════════════════════════════════════════════════════════════════════
