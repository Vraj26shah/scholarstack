{
  "appId": "com.scholarstack.app",
  "appName": "Scholars Stack",
  "webDir": "www",
  "server": {
    "url": "https://scholarstack.campusnotes.workers.dev/app",
    "androidScheme": "https",
    "allowNavigation": ["scholarstack.campusnotes.workers.dev"],
    "errorPath": "offline.html"
  },
  "android": {
    "appendUserAgent": "ScholarsStackApp/student",
    "backgroundColor": "#2F3C7E"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "SplashScreen": {
      "launchShowDuration": 10000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 0,
      "backgroundColor": "#2F3C7E",
      "androidScaleType": "CENTER",
      "showSpinner": false,
      "splashFullScreen": false,
      "splashImmersive": false
    }
  }
}
