{
  "name": "@ss/api",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/node/ops.ts serve",
    "dev:worker": "wrangler dev --port 8787",
    "dev:demo": "tsx watch src/node/server.ts",
    "start:demo": "tsx src/node/server.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "build": "wrangler deploy --dry-run --env production --outdir dist",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "ops": "tsx src/node/ops.ts"
  },
  "dependencies": {
    "@ss/contracts": "workspace:*",
    "@supabase/supabase-js": "^2.49.0",
    "hono": "^4.7.0",
    "jose": "^5.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@hono/node-server": "^1.13.0",
    "@ss/converter": "workspace:*",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.0.0"
  }
}
