{
  // One Worker serves the website (static assets) and the API under /api.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "scholars-stack",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [{ "binding": "NOTES", "bucket_name": "scholarstack" }],
  "ratelimits": [{ "name": "PAGE_LIMITER", "namespace_id": "1001", "simple": { "limit": 40, "period": 60 } }],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "APP_ENV": "development",
    "ALLOWED_EMAIL_DOMAIN": "vitbhopal.ac.in",
    "MAX_DEVICES": "2",
    "VIEWER_TOKEN_TTL_SECONDS": "120",
    "PAGES_PER_DAY": "600",
    "IMPORT_ROOT": "drive-imports/",
    "EMAIL_DAILY_LIMIT": "250"
  },
  "env": {
    "staging": {
      "name": "scholars-stack-staging",
      "r2_buckets": [{ "binding": "NOTES", "bucket_name": "scholarstack" }],
      "ratelimits": [
        { "name": "PAGE_LIMITER", "namespace_id": "1002", "simple": { "limit": 40, "period": 60 } }
      ],
      "vars": {
        "APP_ENV": "staging",
        "ALLOWED_EMAIL_DOMAIN": "vitbhopal.ac.in",
        "MAX_DEVICES": "2",
        "VIEWER_TOKEN_TTL_SECONDS": "120",
        "PAGES_PER_DAY": "600",
        "IMPORT_ROOT": "drive-imports/",
        "EMAIL_DAILY_LIMIT": "250"
      }
    },
    "production": {
      "name": "scholars-stack",
      "r2_buckets": [{ "binding": "NOTES", "bucket_name": "scholarstack" }],
      "ratelimits": [
        { "name": "PAGE_LIMITER", "namespace_id": "1003", "simple": { "limit": 40, "period": 60 } }
      ],
      "triggers": { "crons": ["17 * * * *"] },
      "vars": {
        "APP_ENV": "production",
        "ALLOWED_EMAIL_DOMAIN": "vitbhopal.ac.in",
        "MAX_DEVICES": "2",
        "VIEWER_TOKEN_TTL_SECONDS": "120",
        "PAGES_PER_DAY": "600",
        "IMPORT_ROOT": "drive-imports/",
        "EMAIL_DAILY_LIMIT": "250"
      }
    }
  }
}
