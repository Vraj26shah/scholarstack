{
  // One Worker serves the website (static assets) and the API under /api.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Must match the live Worker: scholarstack.campusnotes.workers.dev → "scholarstack".
  "name": "scholarstack",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Shared pages: so link-preview crawlers get each page's own card (share-preview.ts). Any path
    // in PAGE_PREVIEWS or sharedItem() must be listed here, or the home-page card is served instead.
    "run_worker_first": [
      "/api/*",
      "/c/*",
      "/b/*",
      "/m/*",
      "/tools/*",
      "/get-app",
      "/contribute",
      "/sitemap.xml"
    ]
  },
  "r2_buckets": [{ "binding": "NOTES", "bucket_name": "scholarstack" }],
  "ratelimits": [{ "name": "PAGE_LIMITER", "namespace_id": "1001", "simple": { "limit": 40, "period": 60 } }],
  "triggers": { "crons": ["17 * * * *", "*/5 * * * *"] },
  // Big reminder sends: the five-minute run hands batches to this queue, and each batch is sent
  // by a run of its own (its own request budget). One batch per run, never retried (a retry would
  // send twice; the next five-minute run retries failures). Create once: wrangler queues create scholarstack-push
  "queues": {
    "producers": [{ "binding": "PUSH_QUEUE", "queue": "scholarstack-push" }],
    "consumers": [
      { "queue": "scholarstack-push", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 0 }
    ]
  },
  "observability": { "enabled": true },
  // ADMIN_EMAILS, APP_URL and every key are Worker *secrets* (pnpm secrets:push). Never list them
  // here too: Cloudflare refuses a deploy that has the same name as a variable and a secret.
  "vars": {
    "APP_ENV": "development",
    "ALLOWED_EMAIL_DOMAIN": "vitbhopal.ac.in",
    "MAX_DEVICES": "2",
    "VIEWER_TOKEN_TTL_SECONDS": "120",
    "PAGES_PER_DAY": "600",
    "IMPORT_ROOT": "drive-imports/",
    "CONVERTER_GITHUB_REPOSITORY": "Vraj26shah/scholarstack",
    "EMAIL_DAILY_LIMIT": "300",
    "SIGNIN_EMAIL_DAILY_LIMIT": "250"
  },
  "env": {
    "staging": {
      "name": "scholarstack-staging",
      "r2_buckets": [{ "binding": "NOTES", "bucket_name": "scholarstack" }],
      "ratelimits": [
        { "name": "PAGE_LIMITER", "namespace_id": "1002", "simple": { "limit": 40, "period": 60 } }
      ],
      "vars": {
        "APP_ENV": "staging",
        "ALLOWED_EMAIL_DOMAIN": "vitbhopal.ac.in",
        "MAX_DEVICES": "2",
        "VIEWER_TOKEN_TTL_SECONDS": "120",
        "PAGES_PER_DAY": "600",
        "IMPORT_ROOT": "drive-imports/",
        "CONVERTER_GITHUB_REPOSITORY": "Vraj26shah/scholarstack",
        "EMAIL_DAILY_LIMIT": "300",
        "SIGNIN_EMAIL_DAILY_LIMIT": "250"
      }
    },
    "production": {
      "name": "scholarstack",
      "r2_buckets": [{ "binding": "NOTES", "bucket_name": "scholarstack" }],
      "ratelimits": [
        { "name": "PAGE_LIMITER", "namespace_id": "1003", "simple": { "limit": 40, "period": 60 } }
      ],
      "triggers": { "crons": ["17 * * * *", "*/5 * * * *"] },
      // Big reminder sends: the five-minute run hands batches to this queue, and each batch is sent
      // by a run of its own (its own request budget). One batch per run, never retried (a retry would
      // send twice; the next five-minute run retries failures). Create once: wrangler queues create scholarstack-push
      "queues": {
        "producers": [{ "binding": "PUSH_QUEUE", "queue": "scholarstack-push" }],
        "consumers": [
          { "queue": "scholarstack-push", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 0 }
        ]
      },
      "vars": {
        "APP_ENV": "production",
        "ALLOWED_EMAIL_DOMAIN": "vitbhopal.ac.in",
        "MAX_DEVICES": "2",
        "VIEWER_TOKEN_TTL_SECONDS": "120",
        "PAGES_PER_DAY": "600",
        "IMPORT_ROOT": "drive-imports/",
        "CONVERTER_GITHUB_REPOSITORY": "Vraj26shah/scholarstack",
        "EMAIL_DAILY_LIMIT": "300",
        "SIGNIN_EMAIL_DAILY_LIMIT": "250"
      }
    }
  }
}
